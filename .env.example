# ==============================================================================
# Event Horizon: Singularity — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. On-Premises & Air-Gapped Enclave Deployment (Default / Recommended)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# Storage Driver: 'local' (On-Premises / Air-Gapped Disk) or 'gcs' (Google Cloud Storage)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/evidence

# Database mode. PostgreSQL is the default and there is NO silent fallback: if it is unreachable the server exits.
# For local development without PostgreSQL, opt in explicitly (data is lost on restart; refused in production):
# DB_MODE=memory

# Identity provider: "firebase" (default) or "local" for air-gapped installs (bcrypt + locally signed JWTs).
# AUTH_MODE=local
# LOCAL_AUTH_SECRET=      # required with AUTH_MODE=local: 32+ random characters (openssl rand -hex 32)
# The first administrator is created in the browser by the first-time setup wizard (it locks itself once used).
# SETUP_TOKEN=            # optional: the wizard asks for this value, so nobody who reaches a fresh install first can claim it
# (Recovery only: LOCAL_USER_PASSWORD=... npm run auth:create-user -- you@example.mil "Your Name")
# ALLOW_TENANT_CREATION=false   # turn off self-service POST /api/v1/tenants
# PLATFORM_ADMIN_EMAILS=admin@example.mil,ops@example.mil   # extra platform administrators besides the one the setup wizard creates; setting it also closes the wizard (see docs/ASSESSMENT_PROGRAMS.md)

# AI analysis of imported System Security Plans (docs/SSP_IMPORT.md): a LOCAL Ollama server, never an external service.
# Off by default; imports then use rule-based matching only.
# SSP_AI_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434   # Docker: http://ollama:11434 or http://host.docker.internal:11434. A host outside this machine / private network is refused.
# OLLAMA_MODEL=llama3.1:8b                 # must already be installed (ollama pull / ollama create): nothing is downloaded by the platform
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=240000
# SSP_AI_MAX_SECTIONS=150                  # longest document the AI reads in full; beyond this only the most relevant sections
# SSP_AI_MAX_CANDIDATES=4                 # controls offered to the model per section (small models: keep low)
# SSP_AI_RETRIEVAL_MIN_SCORE=9             # minimum keyword score for a control to be offered
# SSP_AI_MIN_CONFIDENCE=0.5                # suggestions below this never reach the review screen
# SSP_AI_GAP_MODE=extractive               # "extractive": the model copies supporting sentences (3B); "narrative": it writes the comparison (8B+)
# SSP_AI_GAP_ANALYSIS=true                 # compare each suggestion with the NIST SP 800-171A objectives (one more model call per control)

# Database Connection (PostgreSQL 16 with Row-Level Security)
# Option A: one standard connection string (takes precedence over the DB_* values below).
#   Connect as an ORDINARY role: PostgreSQL superusers and BYPASSRLS roles skip row-level security entirely.
# DATABASE_URL=postgres://grc_app:change-me@db.internal:5432/cmmc_compliance_db?sslmode=require
# Optional TLS for either option (certificate verification stays on unless DB_SSL_REJECT_UNAUTHORIZED=false)
# DB_SSL=true
# Option B: discrete settings (a DB_HOST starting with "/" is a Cloud SQL Unix socket)
DB_HOST=singularity-db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres_secure_pass
DB_NAME=cmmc_compliance_db

# Frontend Application API URL (Leave blank for relative same-origin routing in Docker)
VITE_API_URL=

# ------------------------------------------------------------------------------
# 2. Cloud Deployment (Google Cloud Platform / Cloud SQL / GCS) - Optional
# ------------------------------------------------------------------------------
VITE_GCP_PROJECT_ID=grc-tool-507203
VITE_GCP_REGION=us-central1
VITE_GCS_BUCKET_NAME=pbc-grc-evidence-prod
VITE_GCP_CLOUD_SQL_INSTANCE=pbc-grc-postgres-primary
VITE_GCP_DATABASE_NAME=cmmc_compliance_db
VITE_GCP_IDENTITY_DOMAIN=pitchblackcyber.com
VITE_APP_URL=https://grc.pitchblackcyber.com

# Google Cloud Identity Platform / Firebase Auth Configuration
VITE_FIREBASE_API_KEY=AIzaSyA_ExampleApiKeyForGcpIdentityPlatform
VITE_FIREBASE_AUTH_DOMAIN=grc-tool-507203.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=grc-tool-507203
VITE_FIREBASE_STORAGE_BUCKET=grc-tool-507203.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1048293847291
VITE_FIREBASE_APP_ID=1:1048293847291:web:9b8f7e6d5c4b3a2
