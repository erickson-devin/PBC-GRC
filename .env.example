# ==============================================================================
# Event Horizon: Singularity — Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. On-Premises & Air-Gapped Enclave Deployment (Default / Recommended)
# ------------------------------------------------------------------------------
# Unset counts as production (safeguards on, startup warning). npm run dev sets development on its own.
NODE_ENV=production
PORT=3000

# Network exposure. The default binds ALL interfaces so the Unraid WebUI is reachable on the LAN.
# Set APP_BIND_ADDRESS=127.0.0.1 when a reverse proxy on the same host fronts the app.
# See docs/ON_PREM_DATABASE.md "Network exposure".
# APP_BIND_ADDRESS=0.0.0.0
# APP_PORT=3000
# Docker Compose only: the host address the app port is published on (default 0.0.0.0, all interfaces).
# Set APP_PUBLISH_ADDRESS=127.0.0.1 when a TLS reverse proxy on the same host fronts the app (the container keeps APP_BIND_ADDRESS=0.0.0.0).
# APP_PUBLISH_ADDRESS=0.0.0.0
# Docker Compose only: the image release to run (default: the release docker-compose.yml ships with). A version tag, never latest;
# vX.Y.Z@sha256:<digest> pins the exact image (docs/ON_PREM_DATABASE.md "Releases"). Change it only when upgrading.
# IMAGE_TAG=v1.0.0

# Evidence storage: local disk only; any other STORAGE_PROVIDER value is refused at startup
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/evidence

# Docker Compose database secrets (read by docker-compose.yml only; compose refuses to start without the two passwords).
POSTGRES_PASSWORD=        # REQUIRED: password of the database admin account (bootstraps the database; the app never uses it)
APP_DB_USER=grc_app       # the application's database role (the app connects as this role)
APP_DB_PASSWORD=          # REQUIRED: password of the application's database role

# Docker Compose host paths (read by docker-compose.yml only; the defaults are a named volume or the repository folder).
# The values shown are the Unraid installation; set them in the .env next to docker-compose.yml.
# DB_DATA_DIR=/mnt/cache/appdata/singularity/postgres            # PostgreSQL data directory (default: named volume postgres_data)
# EVIDENCE_DIR=/mnt/cache/appdata/singularity/evidence           # evidence vault (default ./data/evidence)
# OLLAMA_MODELS_DIR=/mnt/user/appdata/singularity/ollama-models  # Ollama model store, ai profile (default: named volume ollama-models)
# INITDB_DIR=/mnt/user/appdata/singularity/docker/postgres       # database init scripts (default ./docker/postgres, the repository copy)

# Database mode. PostgreSQL is the default and there is NO silent fallback: if it is unreachable the server exits.
# For local development without PostgreSQL, opt in explicitly (data is lost on restart; needs NODE_ENV=development (npm run dev) or test; refused otherwise):
# DB_MODE=memory

# Identity: local accounts only (bcrypt + locally signed JWTs). AUTH_MODE may be omitted or `local`; anything else is refused at startup.
# AUTH_MODE=local
LOCAL_AUTH_SECRET=        # REQUIRED: 32+ random characters (openssl rand -hex 32)
# ALLOW_DEV_MOCK_TOKENS=  # test-only: accepts self-asserted dev tokens; refused unless NODE_ENV is development or test
# The first administrator is created in the browser by the first-time setup wizard (it locks itself once used).
# SETUP_TOKEN=            # optional: the wizard asks for this value, so nobody who reaches a fresh install first can claim it
# MFA_REQUIRED=all        # who must hold a TOTP second factor (NIST SP 800-171 3.5.3): all (default) | privileged (platform administrators, tenant owners, MSP administrators) | off.
#                         # `off` logs a warning at startup in production. Staged rollout: set `privileged` first, then `all` (docs/ON_PREM_DATABASE.md "Multi-factor authentication").
# MFA_ENCRYPTION_KEY=     # optional: 32+ random characters (openssl rand -hex 32). Through HKDF it encrypts the TOTP secrets and peppers the recovery codes.
#                         # When unset, LOCAL_AUTH_SECRET is used for those too and rotating it then destroys every enrolled factor: set this so the session secret can be rotated
#                         # without touching factors. Rotating MFA_ENCRYPTION_KEY always destroys factors (then run: npm run auth:reset-mfa -- <email>).
# (Recovery only: LOCAL_USER_PASSWORD=... npm run auth:create-user -- you@example.mil "Your Name")
# LOCAL_AUTH_TOKEN_TTL_SECONDS=28800   # session lifetime in seconds (default 28800 = 8 h); keep it at 43200 (12 h) or less
# PASSWORD_HISTORY_DEPTH=5        # previous passwords a new one must differ from (0..24; the current one is always refused)
# SESSION_IDLE_MINUTES=15   # sign a session out after this many minutes without a request (AC.L2-3.1.10/3.1.11); 0 disables; the browser locks the screen after the same idle period
# ALLOW_TENANT_CREATION=false  # turn off self-service POST /api/v1/tenants
# PLATFORM_ADMIN_EMAILS=admin@example.mil,ops@example.mil   # extra platform administrators besides the one the setup wizard creates; setting it also closes the wizard (see docs/ASSESSMENT_PROGRAMS.md)

# AI analysis of imported System Security Plans (docs/SSP_IMPORT.md): a LOCAL Ollama server, never an external service.
# On in docker-compose.yml (SSP_AI_ENABLED defaults to true there); if Ollama is not running, imports use rule-based matching only.
# Set false to switch the AI analysis off.
# SSP_AI_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434   # Docker: http://ollama:11434 or http://host.docker.internal:11434. A host outside this machine / private network is refused.
# OLLAMA_MODEL=llama3.2:3b                # must already be installed (ollama pull / ollama create): nothing is downloaded by the platform
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_MS=240000
# SSP_AI_MAX_SECTIONS=150                  # longest document the AI reads in full; beyond this only the most relevant sections
# SSP_AI_MAX_CANDIDATES=4                 # controls offered to the model per section (small models: keep low)
# SSP_AI_RETRIEVAL_MIN_SCORE=9             # minimum keyword score for a control to be offered
# SSP_AI_MIN_CONFIDENCE=0.5                # suggestions below this never reach the review screen
# SSP_AI_GAP_MODE=extractive               # "extractive": the model copies supporting sentences (3B); "narrative": it writes the comparison (8B+)
# SSP_AI_GAP_ANALYSIS=true                 # compare each suggestion with the NIST SP 800-171A objectives (one more model call per control)

# Vulnerability management ingest (docs/VULNERABILITY_MANAGEMENT.md). All optional; the defaults are shown.
# VM_INGEST_MAX_BYTES=67108864             # largest accepted POST /api/v1/vm/ingest body: 64 MB by default, never more than 104857600 (100 MB)
# TRUST_PROXY=                             # the TLS reverse proxy's address: an IP, a CIDR, a comma-separated list, or "loopback". Never "true" or a hop count.
#                                          # X-Forwarded-Proto is honoured only from that address. Bind the app port to 127.0.0.1 when the proxy runs on the same host.
#                                          # Service tokens can only be created over HTTPS (req.secure), so set this when TLS ends at a proxy.
#                                          # It also keys the per-IP sign-in throttle: unset behind a proxy, every user shares the proxy's address (the server warns once).
# REQUIRE_TLS=false   # true: plain-HTTP requests are refused (403 on /api, 301 to https:// for pages; GET /api/v1/health stays open for the container health check). Needs TRUST_PROXY (the server refuses to start otherwise).
# VM_ALLOW_INSECURE_TOKENS=false         # true allows creating service tokens over plain HTTP (a warning is logged each time); leave off in production
# VM_SLA_DAYS_CRITICAL=15                 # days allowed to remediate a CRITICAL finding after first sight. KEV (known exploited) findings always get this deadline at most
# VM_SLA_DAYS_HIGH=30                      # HIGH
# VM_SLA_DAYS_MEDIUM=90                    # MEDIUM (also used for UNKNOWN severity)
# VM_SLA_DAYS_LOW=180                      # LOW
# VM_POAM_AUTOCREATE=true                  # an overdue finding gets a draft POA&M item at the end of each run. Onboarding a backlog creates one per overdue finding on the first run: set false to defer
# VM_SCHEDULER_TICK_MINUTES=60             # in-process tick: source staleness and whether a snapshot is due (1..1440)
# VM_SNAPSHOT_INTERVAL_HOURS=168           # automatic evidence snapshot per tenant, also the report window (1..8760)
# VM_COVERAGE_THRESHOLD=0.95               # share of in-scope assets that must report in the window (0..1)
# ASSESSMENT_EVENT_RETENTION_DAYS=1095    # control change history (who, when, SHA-256 of notes) kept this many days, deleted daily; 0 = keep forever
# ACCOUNT_EVENT_RETENTION_DAYS=1095       # account event log (password / MFA / role / sign-out events: ids only, never an email) kept this many days, deleted daily; 0 = keep forever

# Database Connection (PostgreSQL 16 with Row-Level Security)
# Option A: one standard connection string (takes precedence over the DB_* values below).
#   Connect as an ORDINARY role: PostgreSQL superusers and BYPASSRLS roles skip row-level security entirely.
# DATABASE_URL=postgres://grc_app:change-me@db.internal:5432/cmmc_compliance_db?sslmode=require
# Optional TLS for either option (certificate verification stays on unless DB_SSL_REJECT_UNAUTHORIZED=false)
# DB_SSL=true
# Option B: discrete settings (DB_HOST defaults to 127.0.0.1; an absolute path is a PostgreSQL Unix-socket directory)
DB_HOST=singularity-db
DB_PORT=5432
# The ordinary application role, NEVER the PostgreSQL superuser: superusers bypass row-level security (tenant isolation),
# and the server refuses to start in production when connected as one.
DB_USER=grc_app
DB_PASS=postgres_secure_pass
DB_NAME=cmmc_compliance_db

# Frontend Application API URL (Leave blank for relative same-origin routing in Docker)
VITE_API_URL=

# Build identity: the git commit of this build, shown in the UI and in GET /api/v1/health (buildCommit).
# Set by the Docker build (docker build --build-arg BUILD_COMMIT=$(git rev-parse HEAD)); defaults to dev.
# BUILD_COMMIT=

# Photon (SCAP scanning) link in the sidebar: hidden when unset. Build-time variable (read when the client is built).
# VITE_PHOTON_URL=
