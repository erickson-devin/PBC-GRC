{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pbc-grc:vm:ingest:1",
  "title": "PBC-GRC vulnerability ingest payload",
  "description": "Pushed by an exporter inside the enclave to POST /api/v1/vm/ingest. Also enforced by server/vm/ingestSchema.ts, which adds checks JSON Schema cannot express: at most 50000 findings in total, agent_id unique within the payload, and date-times that parse.",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "exporter", "collected_at", "hosts"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": { "enum": ["WAZUH", "SENTINELONE", "ACTION1", "GREENBONE", "NUCLEI", "NMAP"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" }
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "version": { "type": "string", "pattern": "^[A-Za-z0-9.+_-]{1,32}$" }
      }
    },
    "collected_at": { "$ref": "#/$defs/dateTime" },
    "hosts": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/host" }
    }
  },
  "$defs": {
    "line": { "type": "string", "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
    "dateTime": { "type": "string", "format": "date-time", "maxLength": 40 },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "findings"],
      "properties": {
        "agent_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "hostname": { "type": "string", "maxLength": 255, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "ip": { "type": "string", "pattern": "^[A-Za-z0-9.:_/%-]{0,64}$" },
        "mac": { "type": "string", "pattern": "^[0-9A-Fa-f:.-]{0,32}$" },
        "os": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
            "version": { "type": "string", "maxLength": 64, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" }
          }
        },
        "findings": {
          "type": "array",
          "maxItems": 5000,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vuln_id", "severity"],
      "properties": {
        "vuln_id": { "type": "string", "pattern": "^(CVE-[0-9]{4}-[0-9]{4,7}|[A-Za-z0-9][A-Za-z0-9._:-]{0,63})$" },
        "title": { "type": "string", "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
        "severity": { "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"] },
        "cvss_v3": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
            "version": { "type": "string", "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]*$" },
            "fixed_version": { "type": ["string", "null"], "maxLength": 128 }
          }
        },
        "detected_at": { "$ref": "#/$defs/dateTime" },
        "published_at": { "type": ["string", "null"], "format": "date-time", "maxLength": 40 },
        "refs": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 2048, "pattern": "^https?://[^\\s]+$" }
        }
      }
    }
  }
}
